@using LicenciasCarpetas.Dashboard.Pages.Shared
@* Tira propia del módulo, debajo del header compartido — agrupada por tipo con
   .nav-group/.nav-group-labeled (las mismas clases que ya agrupan el header de arriba — Casos
   y Certificado por su cuenta, Reportes y Herramientas con su propia etiqueta y línea divisoria),
   mismo patrón que F8/_F8Nav.cshtml. Un solo color neutro por píldora; la que está activa se
   resalta con el acento (dashboard.css). *@
@{
    var path = Context.Request.Path;
    var sector = Context.Request.Query["sector"].ToString();
}
<div class="app-subnav">
    <span class="app-subnav-label">Cambio de Domicilio</span>
    <div class="nav-group">
        <a asp-page="/CambioDomicilio/Index" class="nav-casos @(ModuleSubnav.IsActive(path, "/CambioDomicilio/Index") ? "active" : "")">Casos</a>
        <a asp-page="/CambioDomicilio/Certificado" class="nav-certificado @(ModuleSubnav.IsActive(path, "/CambioDomicilio/Certificado") ? "active" : "")">Certificado</a>
    </div>
    <div class="nav-group nav-group-labeled">
        <span class="nav-group-label">Reportes</span>
        <span class="nav-group-pills">
            <a asp-page="/CambioDomicilio/Estadisticas" class="nav-estadisticas @(ModuleSubnav.IsActive(path, "/CambioDomicilio/Estadisticas") ? "active" : "")">Estadísticas</a>
            <a asp-page="/CambioDomicilio/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo @(ModuleSubnav.IsSectorActive(path, "/CambioDomicilio/Sector", sector, "Archivo") ? "active" : "")">PDF Archivo</a>
            <a asp-page="/CambioDomicilio/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43 @(ModuleSubnav.IsSectorActive(path, "/CambioDomicilio/Sector", sector, "Oficina43") ? "active" : "")">PDF Oficina 43</a>
        </span>
    </div>
    <div class="nav-group nav-group-labeled">
        <span class="nav-group-label">Herramientas</span>
        <span class="nav-group-pills">
            <a asp-page="/CambioDomicilio/Comunas" class="nav-module-tool @(ModuleSubnav.IsActive(path, "/CambioDomicilio/Comunas") ? "active" : "")">Comunas</a>
            <a asp-page="/CambioDomicilio/Discarded" class="nav-module-tool @(ModuleSubnav.IsActive(path, "/CambioDomicilio/Discarded") ? "active" : "")">Descartados</a>
        </span>
    </div>
</div>
