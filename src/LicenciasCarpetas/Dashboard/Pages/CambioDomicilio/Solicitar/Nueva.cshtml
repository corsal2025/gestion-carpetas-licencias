@page
@model LicenciasCarpetas.Dashboard.Pages.CambioDomicilio.Solicitar.NuevaModel
@{
    ViewData["Title"] = Model.ReadOnly ? "Ver Solicitud" : (Model.RequestId is null ? "Nueva Solicitud" : "Editar Solicitud");
}

<h1 class="text-xl" style="margin:0 0 4px;">Petición de Cambio de Domicilio</h1>
<p class="text-sm" style="color:var(--color-text-muted); margin:0 0 16px;">
    Ingrese los datos requeridos para actualizar el registro municipal. Los campos marcados con * son obligatorios.
</p>

@if (Model.Message is not null)
{
    <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
}

<form method="post" asp-page-handler="GuardarBorrador" asp-route-id="@Model.RequestId" id="solicitud-form">
    <div style="display:flex; gap:16px; align-items:flex-start; flex-wrap:wrap;">
        <div style="flex:1 1 60%; min-width:320px; display:flex; flex-direction:column; gap:16px;">
            <div class="card solicitud-card solicitud-card-accent-primary">
                <div class="solicitud-card-header">👤 Datos del Contribuyente</div>
                <div class="solicitud-field-grid">
                    <div>
                        <label class="form-label" for="input-rut">RUT *</label>
                        <div class="solicitud-input-wrap">
                            <input type="text" id="input-rut" asp-for="Input.Rut" required disabled="@Model.ReadOnly" placeholder="ej: 18.785.387-7" class="solicitud-input" />
                            @if (!string.IsNullOrWhiteSpace(Model.Input.Rut))
                            {
                                <span class="solicitud-input-check" title="RUT ingresado">✓</span>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="input-phone">Teléfono de Contacto</label>
                        <input type="text" id="input-phone" asp-for="Input.Phone" disabled="@Model.ReadOnly" placeholder="+56 9 XXXX XXXX" class="solicitud-input" />
                    </div>
                    <div style="grid-column:1 / -1;">
                        <label class="form-label" for="input-fullname">Nombre Completo / Razón Social *</label>
                        <input type="text" id="input-fullname" asp-for="Input.FullName" required disabled="@Model.ReadOnly" class="solicitud-input" />
                    </div>
                </div>
            </div>

            <div class="card solicitud-card solicitud-card-accent-secondary">
                <div class="solicitud-card-header">📍 Nuevo Domicilio</div>
                <div class="solicitud-field-grid">
                    <div>
                        <label class="form-label" for="input-street">Calle / Avenida *</label>
                        <input type="text" id="input-street" asp-for="Input.Street" required disabled="@Model.ReadOnly" placeholder="Ej. Av. Providencia" class="solicitud-input" />
                    </div>
                    <div>
                        <label class="form-label" for="input-number">Número *</label>
                        <input type="text" id="input-number" asp-for="Input.Number" required disabled="@Model.ReadOnly" placeholder="Ej. 1234" class="solicitud-input" />
                    </div>
                    <div>
                        <label class="form-label" for="input-comuna">Comuna *</label>
                        <select id="input-comuna" asp-for="Input.DestinationComuna" required disabled="@Model.ReadOnly" class="solicitud-input">
                            <option value="">Seleccionar Comuna...</option>
                            @foreach (var contact in Model.ComunaOptions)
                            {
                                <option value="@contact.Comuna">@contact.Comuna</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="input-unit">Oficina / Depto (opcional)</label>
                        <input type="text" id="input-unit" asp-for="Input.Unit" disabled="@Model.ReadOnly" placeholder="Ej. Of 401" class="solicitud-input" />
                    </div>
                    <div class="solicitud-info-box" style="grid-column:1 / -1;">
                        ℹ️ Verifique que la dirección se encuentre dentro de los límites jurisdiccionales de la comuna de destino para evitar rechazos automáticos.
                    </div>
                </div>
            </div>

            @if (!Model.ReadOnly)
            {
                <div class="solicitud-actions">
                    @if (Model.RequestId.HasValue)
                    {
                        <button type="submit" form="enviar-form" class="btn-solicitud-primary"
                                onclick="return confirm('Esto enviará la solicitud a la comuna de destino. ¿Confirmar?');">ENVIAR PETICIÓN ▷</button>
                    }
                    <button type="submit" class="btn-solicitud-secondary">GUARDAR BORRADOR</button>
                    <a asp-page="/CambioDomicilio/Solicitar/Index" class="btn-solicitud-cancel">⊗ CANCELAR</a>
                </div>
            }
            else
            {
                <div>
                    <a asp-page="/CambioDomicilio/Solicitar/Index" class="btn-solicitud-secondary" style="display:inline-block;">Volver</a>
                </div>
            }
        </div>

        <div style="flex:1 1 30%; min-width:260px;">
            <div class="card solicitud-card">
                <div class="solicitud-card-header">📎 Documentación</div>

                @if (Model.Attachments.Count > 0)
                {
                    <ul style="list-style:none; padding:0; margin:0 0 12px 0; display:flex; flex-direction:column; gap:8px;">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <li class="solicitud-doc-item verified">
                                <span style="display:flex; align-items:center; gap:8px; min-width:0;">
                                    <span>📄</span>
                                    <span style="min-width:0;">
                                        <span style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@attachment.FileName</span>
                                        <span class="solicitud-doc-status verified">✓ Verificado en Sistema</span>
                                    </span>
                                </span>
                                <span>✅</span>
                                @if (!Model.ReadOnly)
                                {
                                    <form method="post" asp-page-handler="EliminarArchivo" style="margin:0;"
                                          onsubmit="return confirm('¿Eliminar este documento adjunto?');">
                                        <input type="hidden" name="id" value="@Model.RequestId" />
                                        <input type="hidden" name="attachmentId" value="@attachment.Id" />
                                        <button type="submit" class="btn-danger" title="Eliminar" aria-label="Eliminar" style="padding:2px 8px;">&times;</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm" style="color:var(--color-text-muted);">Sin documentos adjuntos.</p>
                }

                @if (!Model.ReadOnly)
                {
                    <form method="post" asp-page-handler="SubirArchivo" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="@Model.RequestId" />
                        <label class="solicitud-dropzone">
                            <span style="font-size:1.4rem; display:block;">☁️</span>
                            Arrastre archivos aquí o <u>examine</u>
                            <input type="file" name="NewAttachment" accept=".pdf,.jpg,.jpeg" style="display:block; margin:8px auto 0;" />
                            <span class="text-xs" style="display:block; margin-top:4px; color:var(--color-text-muted);">MÁX 5MB — PDF/JPG</span>
                        </label>
                        <button type="submit" class="btn-solicitud-secondary" style="margin-top:8px; width:100%;">Adjuntar</button>
                    </form>
                }
            </div>
        </div>
    </div>
</form>

@if (!Model.ReadOnly && Model.RequestId.HasValue)
{
    <form method="post" asp-page-handler="Enviar" asp-route-id="@Model.RequestId" id="enviar-form" style="display:none;"></form>
}
