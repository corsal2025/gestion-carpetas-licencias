@page
@model LicenciasCarpetas.Dashboard.Pages.CambioDomicilio.Solicitar.IndexModel
@using LicenciasCarpetas.CambioDomicilio.Domain
@using LicenciasCarpetas.Domain
@{
    ViewData["Title"] = "Solicitar Cambios de Domicilio";
}

<div class="card cd-filter-bar" style="padding:8px 14px; margin-bottom:10px; display:flex; gap:8px; align-items:center;">
    @* Ya no hay carga manual — las solicitudes entran por el botón Solicitar en Casos o, acá,
       sincronizando el correo de Cambio de Domicilio (ver OnPostSincronizar). *@
    <form method="post" asp-page-handler="Sincronizar">
        <button type="submit" class="btn-primary" style="padding:8px 16px;">↻ Sincronizar Ahora</button>
    </form>
</div>

@if (Model.Message is not null)
{
    <p class="message-banner">@Model.Message</p>
}

<div class="card table-card">
    <table class="cases solicitar-compact">
        <thead>
            <tr style="font-weight:700;">
                <th>Marcar</th>
                <th>Nombre</th>
                <th>RUT</th>
                <th>Comuna</th>
                <th>Recibido</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Requests)
        {
            @* Mismo color de fila por estado que usa Casos (ver FolderStateCatalog.CssClass) —
               la fila se recarga entera al elegir el desplegable de más abajo (no es autoguardado
               por fetch), así que el color ya sale bien server-rendered sin JS aparte. *@
            <tr class="@FolderStateCatalog.CssClass(item.WorkflowState)">
                @* Marcar/Recibido no tienen dato real en una solicitud saliente (no hay carpeta
                   física propia acá) — se muestran inertes. *@
                <td><input type="checkbox" disabled /></td>
                <td>@item.FullName</td>
                <td>@item.Rut</td>
                <td>@item.DestinationComuna</td>
                <td>—</td>
                <td>
                    @* Estado de la carpeta física (subconjunto de Estado de carpeta de Casos) — si
                       la solicitud nació del botón Solicitar en Casos, cambiarlo acá también
                       actualiza el FolderState del caso de origen (ver OnPostGuardarEstado). *@
                    <form method="post" asp-page-handler="GuardarEstado" asp-route-id="@item.Id" style="margin-top:4px;">
                        <select name="workflowState" class="input-inline" style="font-size:inherit;" onchange="this.form.submit()">
                            <option value="">—</option>
                            @foreach (var state in WorkflowStateCatalog.Options)
                            {
                                <option value="@state" selected="@(item.WorkflowState == state)">@WorkflowStateCatalog.Display(state)</option>
                            }
                        </select>
                    </form>
                </td>
                <td style="display:flex; gap:6px; align-items:center; justify-content:center;">
                    @if (item.Status == OutboundRequestStatus.Borrador)
                    {
                        <form method="post" asp-page-handler="Solicitar" asp-route-id="@item.Id" style="display:inline;"
                              onsubmit="return confirm('Esto manda el correo de solicitud a la comuna de inmediato. ¿Confirmar?');">
                            <button type="submit" class="btn-primary" style="padding:4px 10px; font-size:inherit;">Solicitar</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge badge-confirmed">Enviada</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
