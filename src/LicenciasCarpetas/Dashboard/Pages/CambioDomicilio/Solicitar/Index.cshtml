@page
@model LicenciasCarpetas.Dashboard.Pages.CambioDomicilio.Solicitar.IndexModel
@using LicenciasCarpetas.CambioDomicilio.Domain
@{
    ViewData["Title"] = "Solicitar Cambios de Domicilio";
}

<div class="card cd-filter-bar" style="padding:8px 14px; margin-bottom:10px; display:flex; gap:8px; align-items:center;">
    <a asp-page="/CambioDomicilio/Solicitar/Nueva" class="btn-primary" style="padding:8px 16px;">+ Nueva Solicitud</a>
</div>

@if (Model.Message is not null)
{
    <p class="message-banner">@Model.Message</p>
}

<div class="card table-card">
    <table class="cases">
        <thead>
            <tr>
                <th>Marcar</th>
                <th>Nombre</th>
                <th>RUT</th>
                <th>Comuna</th>
                <th>Recibido</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Requests)
        {
            <tr>
                @* Marcar/Recibido no tienen dato real en una solicitud saliente (no hay carpeta
                   física propia acá) — se muestran inertes. *@
                <td><input type="checkbox" disabled /></td>
                <td>@item.FullName</td>
                <td>@item.Rut</td>
                <td>@item.DestinationComuna</td>
                <td>—</td>
                <td>
                    @{
                        var (badgeClass, badgeText) = item.Status switch
                        {
                            OutboundRequestStatus.Borrador => ("badge-pending", "Borrador"),
                            OutboundRequestStatus.Enviada => ("badge-confirmed", "Enviada"),
                            _ => ("badge-pending", item.Status.ToString())
                        };
                    }
                    <span class="badge @badgeClass">@badgeText</span>
                </td>
                <td style="display:flex; gap:6px; align-items:center; justify-content:center;">
                    @if (item.Status == OutboundRequestStatus.Borrador)
                    {
                        <a asp-page="/CambioDomicilio/Solicitar/Nueva" asp-route-id="@item.Id" style="padding:4px 10px; font-size:0.72rem;">Editar</a>
                        @* Envía directo desde el listado, sin entrar a Nueva.cshtml — para cuando
                           ya está todo cargado y solo falta mandar el correo. *@
                        <form method="post" asp-page-handler="Solicitar" asp-route-id="@item.Id" style="display:inline;"
                              onsubmit="return confirm('Esto manda el correo de solicitud a la comuna de inmediato. ¿Confirmar?');">
                            <button type="submit" class="btn-primary" style="padding:4px 10px; font-size:0.72rem;">Solicitar</button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="/CambioDomicilio/Solicitar/Nueva" asp-route-id="@item.Id" style="padding:4px 10px; font-size:0.72rem;">Ver</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
