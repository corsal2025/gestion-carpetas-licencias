@page
@model LicenciasCarpetas.Dashboard.Pages.ImportarModel
@{
    ViewData["Title"] = "Importar Excel";
}

<div class="card" style="padding:20px 24px; margin-bottom:16px;">
    <h1 class="text-xl" style="margin:0 0 8px;">Importar el Excel de carpetas</h1>
    <p class="text-md" style="margin:0 0 14px;">
        Lee las hojas mensuales de agenda (una por oficina), la hoja de escaneadas y subidas, y el
        directorio de correos de comunas. El archivo nunca se modifica: solo se lee. Reimportar el
        mismo archivo actualiza los casos existentes en vez de duplicarlos.
    </p>
    <p class="text-md" style="margin:0 0 14px; opacity:0.8;">
        Carpeta de subida: <code>@Model.UploadDirectory</code>. Los archivos que suba quedan ahí, y
        también puede dejarlos en esa carpeta a mano (por ejemplo sincronizados desde Drive) y
        elegirlos abajo sin volver a subirlos.
    </p>

    @if (Model.ErrorMessage is not null)
    {
        <p class="message-banner message-error">@Model.ErrorMessage</p>
    }

    <form method="post" enctype="multipart/form-data" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div style="flex:1; min-width:320px;">
            <label class="form-label" asp-for="UploadFile">Subir archivo .xlsx</label>
            <input type="file" asp-for="UploadFile" accept=".xlsx" style="width:100%;" />
        </div>

        @if (Model.ExistingFiles.Count > 0)
        {
            <div style="flex:1; min-width:260px;">
                <label class="form-label" asp-for="ExistingFileName">O elegir uno ya subido</label>
                <select asp-for="ExistingFileName" style="width:100%;">
                    <option value="">— seleccione —</option>
                    @foreach (var file in Model.ExistingFiles)
                    {
                        <option value="@file">@file</option>
                    }
                </select>
            </div>
        }

        <button type="submit" class="btn-primary" style="padding:8px 16px;">Importar</button>
    </form>
</div>

@if (Model.Summary is { } summary)
{
    <div class="card" style="padding:20px 24px;">
        <h2 class="text-xl" style="margin:0 0 10px;">Resultado</h2>
        <table class="cases">
            <tbody>
                <tr><td class="text-cell">Hojas leídas</td><td class="text-cell">@summary.SheetsRead</td></tr>
                <tr><td class="text-cell">Filas leídas</td><td class="text-cell">@summary.RowsRead</td></tr>
                <tr><td class="text-cell">Casos nuevos</td><td class="text-cell">@summary.CasesInserted</td></tr>
                <tr><td class="text-cell">Casos actualizados</td><td class="text-cell">@summary.CasesUpdated</td></tr>
                <tr><td class="text-cell">Requieren revisión</td><td class="text-cell">@summary.CasesNeedingReview</td></tr>
                <tr><td class="text-cell">Días con contadores</td><td class="text-cell">@summary.CountersImported</td></tr>
                <tr><td class="text-cell">Correos de comunas</td><td class="text-cell">@summary.ContactsImported</td></tr>
            </tbody>
        </table>

        @if (summary.Warnings.Count > 0)
        {
            <h3 class="text-lg" style="margin:16px 0 6px;">Avisos</h3>
            <ul class="text-md">
                @foreach (var warning in summary.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        }

        <p style="margin-top:14px;"><a class="nav-pill" asp-page="/Index">Ver casos</a></p>
    </div>
}
