@using LicenciasCarpetas.Dashboard.Pages.Shared
@* Tira propia del módulo, debajo del header compartido — mismo patrón que
   CambioDomicilio/_CambioDomicilioNav.cshtml: agrupada por tipo con .nav-group/.nav-group-labeled
   (las mismas clases que ya agrupan el header de arriba — Casos por su cuenta, Reportes y
   Herramientas con su propia etiqueta y línea divisoria), no una fila plana de píldoras sueltas. *@
@{
    var path = Context.Request.Path;
    var sector = Context.Request.Query["sector"].ToString();
}
<div class="app-subnav">
    <span class="app-subnav-label">F8 Urgentes</span>
    <div class="nav-group">
        <a asp-page="/F8/Index" class="nav-casos @(ModuleSubnav.IsActive(path, "/F8/Index") ? "active" : "")">Casos</a>
    </div>
    <div class="nav-group nav-group-labeled">
        <span class="nav-group-label">Reportes</span>
        <span class="nav-group-pills">
            <a asp-page="/F8/Estadisticas" class="nav-estadisticas @(ModuleSubnav.IsActive(path, "/F8/Estadisticas") ? "active" : "")">Estadísticas</a>
            <a asp-page="/F8/SectorF8" asp-route-sector="Archivo" class="nav-pdf-archivo @(ModuleSubnav.IsSectorActive(path, "/F8/SectorF8", sector, "Archivo") ? "active" : "")">PDF Archivo</a>
            <a asp-page="/F8/SectorF8" asp-route-sector="Oficina43" class="nav-pdf-oficina43 @(ModuleSubnav.IsSectorActive(path, "/F8/SectorF8", sector, "Oficina43") ? "active" : "")">PDF Oficina 43</a>
        </span>
    </div>
    <div class="nav-group nav-group-labeled">
        <span class="nav-group-label">Herramientas</span>
        <span class="nav-group-pills">
            <a asp-page="/F8/ImpresionMensual" class="nav-module-tool @(ModuleSubnav.IsActive(path, "/F8/ImpresionMensual") ? "active" : "")">Impresión mensual</a>
        </span>
    </div>
</div>
