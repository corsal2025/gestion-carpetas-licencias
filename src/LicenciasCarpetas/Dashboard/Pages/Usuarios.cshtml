@page
@using LicenciasCarpetas.Dashboard.Auth
@model LicenciasCarpetas.Dashboard.Pages.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

@if (Model.Message is not null)
{
    <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
}

<div class="card" style="padding:20px 24px; margin-bottom:16px; max-width:820px;">
    <h1 style="font-size:1.1rem; margin:0 0 4px;">Crear usuario</h1>
    <p style="font-size:0.82rem; margin:0 0 14px;">
        Mínimo @LicenciasCarpetas.Dashboard.Auth.UserProvisioning.MinimumPasswordLength caracteres.
        El nombre de usuario no distingue mayúsculas.
    </p>
    <form method="post" asp-page-handler="Create" class="usuario-form" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label">Usuario</label>
            <input type="text" name="usuario" required placeholder="ej: raul" autocomplete="off" />
        </div>
        <div>
            <label class="form-label">Contraseña</label>
            <input type="password" name="clave" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Repetir contraseña</label>
            <input type="password" name="confirmacion" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Rol</label>
            <select name="rol" class="rol-select">
                @foreach (var rol in Enum.GetValues<UserRole>())
                {
                    <option value="@rol" selected="@(rol == UserRole.Administrativo)">@UserRoleCatalog.Display(rol)</option>
                }
            </select>
        </div>
        <div class="modulos-administrativo">
            <label class="form-label">Módulos (solo Administrativo)</label>
            <label style="display:flex; gap:4px; align-items:center; font-size:0.8rem;">
                <input type="checkbox" name="moduloCambioDomicilio" value="true" /> Cambio de Domicilio
            </label>
            <label style="display:flex; gap:4px; align-items:center; font-size:0.8rem;">
                <input type="checkbox" name="moduloF8" value="true" /> F8 Urgentes
            </label>
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Crear</button>
    </form>
</div>

<div class="card" style="padding:20px 24px; margin-bottom:16px; max-width:640px;">
    <h2 style="font-size:1rem; margin:0 0 4px;">Cambiar la contraseña de un usuario</h2>
    <p style="font-size:0.82rem; margin:0 0 14px;">
        Para cuando alguien olvida la suya. Deja la cuenta desbloqueada de inmediato.
    </p>
    <form method="post" asp-page-handler="SetPassword" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label">Usuario</label>
            <select name="usuario" required>
                @foreach (var username in Model.Usernames)
                {
                    <option value="@username">@username</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Contraseña nueva</label>
            <input type="password" name="clave" required class="reveal-target" autocomplete="new-password" />
        </div>
        <div>
            <label class="form-label">Repetir contraseña</label>
            <input type="password" name="confirmacion" required class="reveal-target" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Cambiar</button>
    </form>
</div>

<label style="display:flex; gap:6px; align-items:center; font-size:0.8rem; margin:0 0 16px 4px;">
    <input type="checkbox" id="reveal-passwords" /> Mostrar las contraseñas
</label>

<div class="card table-card" style="max-width:960px;">
    <table class="cases">
        <thead>
            <tr><th>Usuario</th><th>Rol</th><th>Cambio de Domicilio</th><th>F8 Urgentes</th><th>Acción</th></tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            var esUnoMismo = string.Equals(user.Username, Model.CurrentUsername, StringComparison.OrdinalIgnoreCase);
            var formId = $"role-form-{user.Id}";
            <tr>
                <td class="text-cell">
                    @user.Username
                    @if (esUnoMismo)
                    {
                        <span class="badge badge-confirmed">tu sesión</span>
                    }
                </td>
                <td>
                    <select name="rol" form="@formId" class="rol-select" disabled="@esUnoMismo">
                        @foreach (var rol in Enum.GetValues<UserRole>())
                        {
                            <option value="@rol" selected="@(rol == user.Role)">@UserRoleCatalog.Display(rol)</option>
                        }
                    </select>
                </td>
                <td>
                    <input type="checkbox" name="moduloCambioDomicilio" form="@formId" value="true"
                           checked="@user.CanAccessCambioDomicilio" class="modulo-checkbox"
                           disabled="@(user.Role != UserRole.Administrativo)" />
                </td>
                <td>
                    <input type="checkbox" name="moduloF8" form="@formId" value="true"
                           checked="@user.CanAccessF8Urgentes" class="modulo-checkbox"
                           disabled="@(user.Role != UserRole.Administrativo)" />
                </td>
                <td>
                    @if (!esUnoMismo)
                    {
                        <button type="submit" form="@formId" class="btn-primary" style="padding:4px 10px; font-size:0.78rem;">Guardar</button>
                    }
                    <form id="@formId" method="post" asp-page-handler="UpdateRole" style="display:none;">
                        <input type="hidden" name="usuario" value="@user.Username" />
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* El formulario de eliminar va aparte del de rol — dos <form> no pueden anidarse, y cada fila
   ahora necesita ambos. *@
<div class="card table-card" style="max-width:960px; margin-top:16px;">
    <table class="cases">
        <thead>
            <tr><th>Usuario</th><th>Eliminar</th></tr>
        </thead>
        <tbody>
        @foreach (var username in Model.Usernames)
        {
            <tr>
                <td class="text-cell">@username</td>
                <td>
                    @if (!string.Equals(username, Model.CurrentUsername, StringComparison.OrdinalIgnoreCase))
                    {
                        <form method="post" asp-page-handler="Delete"
                              onsubmit="return confirm('¿Eliminar el usuario @username?');">
                            <input type="hidden" name="usuario" value="@username" />
                            <button type="submit" class="btn-danger" title="Eliminar usuario">✕</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    document.getElementById('reveal-passwords').addEventListener('change', function () {
        var type = this.checked ? 'text' : 'password';
        document.querySelectorAll('.reveal-target').forEach(function (input) { input.type = type; });
    });

    // Los módulos solo aplican a Administrativo — el resto de los roles ya tiene acceso
    // incondicional, así que marcarlos ahí no cambiaría nada y solo confundiría.
    var crearRol = document.querySelector('.usuario-form .rol-select');
    var crearModulos = document.querySelector('.modulos-administrativo');
    function actualizarModulosCreacion() {
        var esAdministrativo = crearRol.value === 'Administrativo';
        crearModulos.style.display = esAdministrativo ? '' : 'none';
    }
    if (crearRol) {
        crearRol.addEventListener('change', actualizarModulosCreacion);
        actualizarModulosCreacion();
    }

    document.querySelectorAll('table.cases tbody tr').forEach(function (row) {
        var rolSelect = row.querySelector('select.rol-select');
        var checkboxes = row.querySelectorAll('.modulo-checkbox');
        if (!rolSelect || checkboxes.length === 0) return;
        rolSelect.addEventListener('change', function () {
            var habilitados = rolSelect.value === 'Administrativo';
            checkboxes.forEach(function (checkbox) { checkbox.disabled = !habilitados; });
        });
    });
</script>
}
