<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gestión de Licencias</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @* Cada módulo trae su propio hoja de estilos, cargada solo en sus páginas — comparten
       las mismas variables de color (mismo autor, misma paleta) así que no chocan si una
       regla genérica (.card, body) queda definida en las dos. *@
    @await RenderSectionAsync("Styles", required: false)
</head>
@* "viewport-locked" solo lo pide la pantalla de Casos, que fija su tabla al alto de la ventana.
   El resto se desplaza como una página normal. *@
<body class="cases-page @ViewData["BodyClass"]">
    @{
        // El título del bloque de marca y qué opción del desplegable "Módulos" se marca activa
        // salen los dos de BrandNavigation.Resolve — antes cada uno recalculaba la ruta actual por
        // su cuenta, con riesgo real de desincronizarse entre sí; ver BrandNavigation.cs y sus tests.
        var nav = LicenciasCarpetas.Dashboard.Pages.Shared.BrandNavigation.Resolve(Context.Request.Path);
        var brandTitle = nav.Title;
        var enCambioDomicilio = nav.EnCambioDomicilio;
        var enF8 = nav.EnF8;
        var enGestionLicencias = nav.EnGestionLicencias;
        var estadisticasPage = nav.EstadisticasPage;
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
                <span>
                    @brandTitle
                    <small>Municipalidad de Valparaíso</small>
                    <small>Depto. Licencias de Conducir</small>
                </span>
            </div>
            @{
                // Mismos roles que los [Authorize(Roles=...)] de cada PageModel — si una pantalla no
                // deja entrar a un rol por URL directa, tampoco le muestra el link.
                var puedeVerReportesYReferencia = User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.IsInRole("Coordinador");
                var puedeImportar = User.IsInRole("Administrador") || User.IsInRole("Jefatura");
                var puedeCambioDomicilio = User.HasClaim("mod:cambio-domicilio", "true");
                var puedeF8 = User.HasClaim("mod:f8-urgentes", "true");
            }
            <nav class="sidebar-nav">
                <a asp-page="/Inicio" class="sidebar-link sidebar-link-home">🏠 Panel de Control</a>

                <details open="@(enGestionLicencias || enCambioDomicilio || enF8 ? "open" : null)" class="sidebar-section sidebar-modules-collapsible">
                    <summary class="sidebar-link sidebar-link-home">📦 Módulos</summary>
                    <a asp-page="/Index" class="sidebar-link @(enGestionLicencias ? "active" : "")">🪪 Gestión de Licencias</a>
                    @* Cambio de Domicilio no es un link plano — tiene dos flujos (recibir pedidos
                       de otras comunas / pedirle a otras comunas), así que el switcher de módulos
                       muestra directamente sus dos entradas en vez de un solo link genérico. *@
                    @if (puedeCambioDomicilio)
                    {
                        <details open="@(enCambioDomicilio ? "open" : null)" class="sidebar-section-collapsible">
                            @* El <summary> envuelve un <a> real — el link sigue navegando a
                               Solicitudes recibidas al hacer clic en el texto, la flechita solo
                               abre/cierra Certificado/Descartados debajo. *@
                            <summary><a asp-page="/CambioDomicilio/Index" class="sidebar-link @(enCambioDomicilio ? "active" : "")">📥 Enviar Cambio de Domicilio</a></summary>
                            @if (enCambioDomicilio)
                            {
                                <a asp-page="/CambioDomicilio/Certificado" class="sidebar-link sidebar-link-reference">📜 Certificado</a>
                                <a asp-page="/CambioDomicilio/Discarded" class="sidebar-link sidebar-link-reference">🗑️ Descartados</a>
                            }
                        </details>
                        <a asp-page="/CambioDomicilio/Solicitar/Index" class="sidebar-link">📤 Solicitar Cambios de Domicilio</a>
                    }
                    @if (puedeF8)
                    {
                        <a asp-page="/F8/Index" class="sidebar-link @(enF8 ? "active" : "")">🚨 F8 Urgentes</a>
                    }
                </details>

                @* Estadísticas y la libreta de Comunas (Gestión de Licencias) quedan afuera de
                   "Módulos" — Estadísticas sigue al módulo activo (una sola entrada, no una por
                   módulo) y Comunas es una consulta transversal, no algo específico de un flujo. *@
                @{
                    var puedeVerEstadisticasDelModuloActivo = enCambioDomicilio || enF8 || puedeVerReportesYReferencia;
                }
                @if (puedeVerEstadisticasDelModuloActivo)
                {
                    <a asp-page="@estadisticasPage" class="sidebar-link sidebar-link-home sidebar-link-module">📈 Estadísticas</a>
                }
                @if (puedeVerReportesYReferencia)
                {
                    <a asp-page="/Comunas" class="sidebar-link sidebar-link-home sidebar-link-reference">🏘️ Comunas</a>
                }
                @if (puedeImportar)
                {
                    <a asp-page="/Importar" class="sidebar-link sidebar-link-home sidebar-link-sync">📥 Importar Excel</a>
                }
            </nav>
            <div class="sidebar-footer">
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-page="/Usuarios" class="sidebar-link">👥 Usuarios</a>
                }
                @if (enGestionLicencias && puedeVerReportesYReferencia)
                {
                    <a asp-page="/Papelera" class="sidebar-link sidebar-link-reference">🗑️ Papelera</a>
                }
                <a asp-page="/ChangePassword" class="sidebar-link sidebar-link-account">🔑 Cambiar contraseña</a>
                <form asp-page="/Logout" method="post"><button type="submit" class="sidebar-link sidebar-link-logout">🚪 Salir</button></form>
            </div>
        </aside>
        <div class="app-content">
            <main>
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
