<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Carpetas Licencias</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
@* "viewport-locked" solo lo pide la pantalla de Casos, que fija su tabla al alto de la ventana.
   El resto se desplaza como una página normal. *@
<body class="cases-page @ViewData["BodyClass"]">
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                Carpetas Licencias
                <small>Municipalidad de Valparaíso</small>
                <small>Depto. Licencias de Conducir</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group nav-group-tools">
                <a asp-page="/Index">Casos</a>
                <a asp-page="/Estadisticas">Estadísticas</a>
                <a asp-page="/Sector" asp-route-sector="Archivo">Archivo</a>
                <a asp-page="/Sector" asp-route-sector="Oficina43">Oficina 43</a>
                <a asp-page="/Comunas">Comunas</a>
                <a asp-page="/Papelera">Papelera</a>
                <a asp-page="/Importar">Importar Excel</a>
            </div>
            <div class="nav-group nav-group-end">
                <a asp-page="/Usuarios" class="nav-pill">Usuarios</a>
                <a asp-page="/ChangePassword" class="nav-pill nav-account">Cambiar contraseña</a>
                <form asp-page="/Logout" method="post"><button type="submit" class="nav-pill nav-logout">Salir</button></form>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
