<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gestión de Licencias</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    @* Cada módulo trae su propio hoja de estilos, cargada solo en sus páginas — comparten
       las mismas variables de color (mismo autor, misma paleta) así que no chocan si una
       regla genérica (.card, body) queda definida en las dos. *@
    @await RenderSectionAsync("Styles", required: false)
</head>
@* "viewport-locked" solo lo pide la pantalla de Casos, que fija su tabla al alto de la ventana.
   El resto se desplaza como una página normal. *@
<body class="cases-page @ViewData["BodyClass"]">
    @{
        // El título del bloque de marca y qué opción del desplegable "Módulos" se marca activa
        // salen los dos de BrandNavigation.Resolve — antes cada uno recalculaba la ruta actual por
        // su cuenta, con riesgo real de desincronizarse entre sí; ver BrandNavigation.cs y sus tests.
        var nav = LicenciasCarpetas.Dashboard.Pages.Shared.BrandNavigation.Resolve(Context.Request.Path);
        var brandTitle = nav.Title;
        var enCambioDomicilio = nav.EnCambioDomicilio;
        var enF8 = nav.EnF8;
        var enGestionLicencias = nav.EnGestionLicencias;
        var estadisticasPage = nav.EstadisticasPage;
    }
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
                <span>
                    @brandTitle
                    <small>Municipalidad de Valparaíso</small>
                    <small>Depto. Licencias de Conducir</small>
                </span>
            </div>
            @{
                // Mismos roles que los [Authorize(Roles=...)] de cada PageModel — si una pantalla no
                // deja entrar a un rol por URL directa, tampoco le muestra el link.
                var puedeVerReportesYReferencia = User.IsInRole("Administrador") || User.IsInRole("Jefatura") || User.IsInRole("Coordinador");
                var puedeImportar = User.IsInRole("Administrador") || User.IsInRole("Jefatura");
                var puedeCambioDomicilio = User.HasClaim("mod:cambio-domicilio", "true");
                var puedeF8 = User.HasClaim("mod:f8-urgentes", "true");
            }
            <nav class="sidebar-nav">
                <a asp-page="/Inicio" class="sidebar-link sidebar-link-home">🏠 Panel de Control</a>

                @* "Módulos" es el desplegable maestro: al abrirlo aparecen los 4 módulos, cada uno
                   con su propio título-desplegable (en vez del link plano de antes) — el título hace
                   el toggle, no un botón aparte, y cada uno trae sus propias Reportes/Comunas/
                   Estadísticas adentro en vez de sueltas más abajo. Se abre solo el módulo activo por
                   defecto (open="@enX"), los demás quedan colapsados hasta que el operador los toque. *@
                <details open class="sidebar-section-collapsible">
                    <summary class="sidebar-section-label">📂 Módulos</summary>

                    <details class="sidebar-section-collapsible" open="@enGestionLicencias">
                        <summary class="sidebar-link sidebar-section-label @(enGestionLicencias ? "active" : "")">🪪 Gestión de Licencias</summary>
                        @if (puedeVerReportesYReferencia)
                        {
                            <a asp-page="/Sector" asp-route-sector="Archivo" class="sidebar-link sidebar-link-doc">📄 Informe Archivo</a>
                            <a asp-page="/Sector" asp-route-sector="Oficina43" class="sidebar-link sidebar-link-doc">📄 Informe Oficina 43</a>
                            <a asp-page="/Comunas" class="sidebar-link sidebar-link-reference">🏘️ Comunas</a>
                        }
                        @if (puedeImportar)
                        {
                            <a asp-page="/Importar" class="sidebar-link sidebar-link-sync">📥 Importar Excel</a>
                        }
                        @if (puedeVerReportesYReferencia)
                        {
                            <a asp-page="/Estadisticas" class="sidebar-link sidebar-link-module">📈 Estadísticas</a>
                        }
                    </details>

                    @* Cambio de Domicilio tiene dos flujos (recibir pedidos de otras comunas / pedirle
                       a otras comunas) — cada uno es su propio desplegable, no un solo módulo genérico. *@
                    @if (puedeCambioDomicilio)
                    {
                        <details class="sidebar-section-collapsible" open="@enCambioDomicilio">
                            <summary class="sidebar-link sidebar-section-label @(enCambioDomicilio ? "active" : "")">📥 Enviar Cambio de Domicilio</summary>
                            <a asp-page="/CambioDomicilio/Index" class="sidebar-link sidebar-link-reference">🗂️ Solicitudes recibidas</a>
                            <a asp-page="/CambioDomicilio/Sector" asp-route-sector="Archivo" class="sidebar-link sidebar-link-doc">📄 Informe Archivo</a>
                            <a asp-page="/CambioDomicilio/Sector" asp-route-sector="Oficina43" class="sidebar-link sidebar-link-doc">📄 Informe Oficina 43</a>
                            <a asp-page="/CambioDomicilio/Certificado" class="sidebar-link sidebar-link-reference">📜 Certificado</a>
                            <a asp-page="/CambioDomicilio/Comunas" class="sidebar-link sidebar-link-reference">🏘️ Comunas</a>
                            <a asp-page="/CambioDomicilio/Discarded" class="sidebar-link sidebar-link-reference">🗑️ Descartados</a>
                            <a asp-page="/CambioDomicilio/Estadisticas" class="sidebar-link sidebar-link-module">📈 Estadísticas</a>
                        </details>
                        <details class="sidebar-section-collapsible" open="@enCambioDomicilio">
                            <summary class="sidebar-link sidebar-section-label">📤 Solicitar Cambios de Domicilio</summary>
                            <a asp-page="/CambioDomicilio/Solicitar/Index" class="sidebar-link sidebar-link-reference">📋 Solicitudes</a>
                            <a asp-page="/CambioDomicilio/Solicitar/Nueva" class="sidebar-link sidebar-link-reference">➕ Nueva Solicitud</a>
                        </details>
                    }

                    @if (puedeF8)
                    {
                        <details class="sidebar-section-collapsible" open="@enF8">
                            <summary class="sidebar-link sidebar-section-label @(enF8 ? "active" : "")">🚨 F8 Urgentes</summary>
                            <a asp-page="/F8/SectorF8" asp-route-sector="Archivo" class="sidebar-link sidebar-link-doc">📄 Informe Archivo</a>
                            <a asp-page="/F8/SectorF8" asp-route-sector="Oficina43" class="sidebar-link sidebar-link-doc">📄 Informe Oficina 43</a>
                            <a asp-page="/F8/ImpresionMensual" class="sidebar-link sidebar-link-reference">🖨️ Impresión mensual</a>
                            <a asp-page="/F8/Estadisticas" class="sidebar-link sidebar-link-module">📈 Estadísticas</a>
                        </details>
                    }
                </details>
            </nav>
            <div class="sidebar-footer">
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-page="/Usuarios" class="sidebar-link">👥 Usuarios</a>
                }
                @if (enGestionLicencias && puedeVerReportesYReferencia)
                {
                    <a asp-page="/Papelera" class="sidebar-link sidebar-link-reference">🗑️ Papelera</a>
                }
                <a asp-page="/ChangePassword" class="sidebar-link sidebar-link-account">🔑 Cambiar contraseña</a>
                <form asp-page="/Logout" method="post"><button type="submit" class="sidebar-link sidebar-link-logout">🚪 Salir</button></form>
            </div>
        </aside>
        <div class="app-content">
            <main>
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
