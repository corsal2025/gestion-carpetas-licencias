@page
@model LicenciasCarpetas.Dashboard.Pages.IndexModel
@{
    ViewData["Title"] = "Casos";
    // Esta pantalla fija su tabla al alto de la ventana para tener siempre a la vista la barra
    // de desplazamiento lateral; ninguna otra lo hace.
    ViewData["BodyClass"] = "viewport-locked";
}

@if (Model.Message is not null)
{
    <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
}

<div class="card" style="padding:5px 12px; margin-bottom:8px;">
    <form method="get" class="filters-bar" style="display:flex; gap:3px 8px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label" for="office">Oficina</label>
            <select name="office" id="office" onchange="this.form.submit()">
                <option value="">Todas</option>
                @foreach (var office in Enum.GetValues<Office>())
                {
                    <option value="@office" selected="@(Model.Office == office)">@OfficeCatalog.Display(office)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="year">Año</label>
            <select name="year" id="year" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var year in Model.Years)
                {
                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="month">Mes</label>
            <select name="month" id="month" onchange="this.form.submit()">
                <option value="">Todos</option>
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.Month == month)">@SpanishDate.MonthName(month)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="estado">Estado de la carpeta</label>
            <select name="estado" id="estado" onchange="this.form.submit()">
                <option value="">Todos</option>
                @foreach (var state in FolderStateCatalog.All)
                {
                    <option value="@state" selected="@(Model.Estado == state)">@FolderStateCatalog.Display(state)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="decision">Decisión final</label>
            <select name="decision" id="decision" onchange="this.form.submit()">
                <option value="">Todas</option>
                @foreach (var decision in FinalDecisionCatalog.All)
                {
                    <option value="@decision" selected="@(Model.Decision == decision)">@FinalDecisionCatalog.Display(decision)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="sector">Sector</label>
            <select name="sector" id="sector" onchange="this.form.submit()">
                <option value="">Todos</option>
                <option value="Archivo" selected="@(Model.Sector == FolderSector.Archivo)">Archivo</option>
                <option value="Oficina43" selected="@(Model.Sector == FolderSector.Oficina43)">Oficina 43</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="search">Buscar</label>
            <input type="text" name="search" id="search" value="@Model.Search" placeholder="RUT o nombre..." />
        </div>
        <label class="text-md" style="display:flex; gap:6px; align-items:center;">
            <input type="checkbox" name="needsReview" value="true" checked="@Model.NeedsReview" onchange="this.form.submit()" />
            Requiere revisión (@Model.NeedsReviewCount)
        </label>
        <label class="text-md" style="display:flex; gap:6px; align-items:center;">
            <input type="checkbox" name="otherComuna" value="true" checked="@Model.OtherComuna" onchange="this.form.submit()" />
            Carpeta en otra comuna
        </label>
        <button type="submit" class="btn-primary text-base" style="padding:3px 12px;">Filtrar</button>
        <a asp-page="/Index" class="nav-pill text-sm">Limpiar</a>
    </form>
</div>

<details class="card" style="padding:8px 14px; margin-bottom:10px;">
    <summary class="text-md" style="cursor:pointer; font-weight:600;">Agregar caso a la agenda</summary>
    <form method="post" asp-page-handler="Add" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-top:12px;">
        <div>
            <label class="form-label">Nombre completo</label>
            <input type="text" name="nombre" required placeholder="ej: Gustavo Peña Castro" style="min-width:220px;" />
        </div>
        <div>
            <label class="form-label">RUT</label>
            <input type="text" name="rut" placeholder="ej: 18.785.387-7" />
        </div>
        <div>
            <label class="form-label">Fecha citación</label>
            <input type="text" name="citacion" placeholder="dd/mes/aaaa" />
        </div>
        <div>
            <label class="form-label">Oficina</label>
            <select name="office">
                @foreach (var office in Enum.GetValues<Office>())
                {
                    <option value="@office">@OfficeCatalog.Display(office)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Última carpeta (fecha o comuna)</label>
            <input type="text" name="ultimaCarpeta" placeholder="dd/mes/aaaa o VIÑA DEL MAR" />
        </div>
        <div>
            <label class="form-label">Penúltima carpeta</label>
            <input type="text" name="penultima" placeholder="dd/mes/aaaa" />
        </div>
        <div>
            <label class="form-label">Código F8</label>
            <input type="text" name="codigoF8" placeholder="ej: F8-2026-114" />
        </div>
        <div>
            <label class="form-label">Estado de la carpeta</label>
            <select name="estado">
                <option value="">—</option>
                @foreach (var state in FolderStateCatalog.Selectable)
                {
                    <option value="@state">@FolderStateCatalog.Display(state)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Decisión final</label>
            <select name="decision">
                <option value="">—</option>
                @foreach (var decision in FinalDecisionCatalog.All)
                {
                    <option value="@decision">@FinalDecisionCatalog.Display(decision)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Idoneidad moral</label>
            <select name="idoneidad">
                <option value="">—</option>
                @foreach (var idoneity in MoralIdoneityCatalog.All)
                {
                    <option value="@idoneity">@MoralIdoneityCatalog.Display(idoneity)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Atención</label>
            <input type="text" name="atencion" placeholder="ej: SI, EN AV. ARGENTINA" />
        </div>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Agregar</button>
    </form>
</details>

@* Paginación arriba de la tabla, no debajo: la tabla llega hasta el borde inferior de la ventana
   y su barra de desplazamiento lateral queda ahí, siempre a la vista. Con los botones abajo, la
   barra subía y se comía la última fila. *@
<div class="text-md" style="display:flex; gap:12px; align-items:center; margin:0 0 8px 4px;">
    <span>@Model.TotalCount caso(s) — página @Model.PageNumber de @Model.TotalPages</span>

    @* Cuántas filas por página. Va como formulario GET con los filtros actuales en campos ocultos,
       para que cambiar la cantidad no pierda lo que el operador tenía filtrado ni el orden. *@
    <form method="get" style="display:flex; gap:6px; align-items:center;">
        @foreach (var (key, value) in Model.RouteValues(1))
        {
            @if (key != "size")
            {
                <input type="hidden" name="@key" value="@value" />
            }
        }
        <label for="size">Ver</label>
        <select name="size" id="size" onchange="this.form.submit()">
            @foreach (var size in LicenciasCarpetas.Dashboard.Pages.IndexModel.PageSizes)
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size</option>
            }
        </select>
        <span>por página</span>
    </form>
    @if (Model.TotalPages > 1)
    {
        @if (Model.PageNumber > 1)
        {
            <a class="nav-pill" asp-page="/Index" asp-all-route-data="@Model.RouteValues(Model.PageNumber - 1)">← Anterior</a>
        }
        @if (Model.PageNumber < Model.TotalPages)
        {
            <a class="nav-pill" asp-page="/Index" asp-all-route-data="@Model.RouteValues(Model.PageNumber + 1)">Siguiente →</a>
        }
    }

    <a asp-page="/Index" asp-page-handler="Export"
       asp-route-office="@Model.Office" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
       asp-route-estado="@Model.Estado" asp-route-decision="@Model.Decision" asp-route-sector="@Model.Sector"
       asp-route-needsReview="@Model.NeedsReview" asp-route-otherComuna="@Model.OtherComuna"
       asp-route-search="@Model.Search" class="nav-pill" style="margin-left:auto;">Exportar a Excel</a>
</div>

@* Sugerencias de la columna ATENCIÓN tal como se escriben en el libro; el campo sigue siendo texto
   libre, la lista solo evita tipearlas completas. *@
<datalist id="atencion-opciones">
    @foreach (var office in Enum.GetValues<Office>())
    {
        <option value="SI, EN @OfficeCatalog.Display(office).ToUpperInvariant()"></option>
    }
</datalist>

<div class="card table-card">
    <table class="cases cases-index">
        <thead>
            <tr>
                <th>Marcar</th>
                @* El texto va dentro de un <span>: escrito como "Oficina@Model...", Razor lee
                   "texto@algo" como una dirección de correo y lo imprime literal en vez de
                   evaluarlo. El ">" que cierra el span rompe esa heurística. *@
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.CitationDate)" class="sort-link"><span>Citación</span>@Model.SortIndicator(CaseSort.CitationDate)</a></th>
                <th class="name-cell"><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Name)" class="sort-link"><span>Nombre completo</span>@Model.SortIndicator(CaseSort.Name)</a></th>
                <th class="rut-cell"><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Rut)" class="sort-link"><span>RUT</span>@Model.SortIndicator(CaseSort.Rut)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.Office)" class="sort-link"><span>Oficina</span>@Model.SortIndicator(CaseSort.Office)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FolderUploadedDate)" class="sort-link"><span>Fecha subida de carpeta</span>@Model.SortIndicator(CaseSort.FolderUploadedDate)</a></th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.LastFolderDate)" class="sort-link"><span>Fecha última carpeta</span>@Model.SortIndicator(CaseSort.LastFolderDate)</a></th>
                @* Sector va junto a Última carpeta: es la fecha de la que se calcula. *@
                <th>Sector</th>
                <th title="Código del caso F8. Texto libre">Código F8</th>
                <th title="Fecha de la carpeta anterior a la última. No influye en el sector">Fecha penúltima carpeta</th>
                <th title="Clases que el contribuyente viene a obtener. Se pueden marcar varias">Tipo de licencia</th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FolderState)" class="sort-link"><span>Estado carpeta</span>@Model.SortIndicator(CaseSort.FolderState)</a></th>
                <th>Idoneidad</th>
                <th><a asp-page="/Index" asp-all-route-data="@Model.SortRouteValues(CaseSort.FinalDecision)" class="sort-link"><span>Decisión final</span>@Model.SortIndicator(CaseSort.FinalDecision)</a></th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
        @{ var rowIndex = 0; }
        @foreach (var item in Model.Cases)
        {
            var rowClass = rowIndex % 2 == 1 ? "row-alt" : "";
            var reviewClass = item.NeedsReview ? "row-needs-review" : "";
            @* El color de la fila viene del estado de la carpeta, igual que en el Excel. *@
            var estadoClass = FolderStateCatalog.CssClass(item.FolderState);
            var duplicadoClass = Model.DuplicateRuts.Contains(item.Rut ?? string.Empty) ? "rut-duplicado" : "";
            @* Idoneidad moral en alerta o por revisar: la fila entera avisa, no solo la celda —
               es lo primero que se necesita ver al mirar la agenda del día. *@
            var idoneidadClass = item.MoralIdoneity switch
            {
                MoralIdoneity.Alertada => "row-alertada",
                MoralIdoneity.Revisar => "row-revisar",
                _ => ""
            };
            rowIndex++;

            @* Cada campo se dimensiona según lo que contiene, así ningún nombre ni comuna queda
               cortado; la tabla crece hacia la derecha y la tarjeta se desplaza en horizontal. *@
            var lastFolderText = item.LastFolderDate is { } lastDate
                ? LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(lastDate)
                : item.LastFolderComuna ?? string.Empty;
            var nameSize = Math.Max(26, (item.FullName?.Length ?? 0) + 2);
            var lastFolderSize = Math.Max(12, lastFolderText.Length + 2);
            var attentionSize = Math.Max(16, (item.AttentionNote?.Length ?? 0) + 2);
            <tr class="@rowClass @estadoClass @duplicadoClass @reviewClass @idoneidadClass">
                <td class="marked-cell">
                    <form method="post" asp-page-handler="ToggleMarked" class="marked-form">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="checkbox" name="markedValue" class="marked-checkbox" @(item.Marked ? "checked" : "")
                               onchange="submitCheckboxToggle(this, 'markedValue')" title="Marcar caso" />
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="Save" id="case-form-@item.Id"
                          asp-route-office="@Model.Office" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                          asp-route-estado="@Model.Estado" asp-route-decision="@Model.Decision" asp-route-sector="@Model.Sector"
                          asp-route-needsReview="@Model.NeedsReview" asp-route-otherComuna="@Model.OtherComuna"
                          asp-route-search="@Model.Search" asp-route-p="@Model.PageNumber">
                        <input type="hidden" name="id" value="@item.Id" />
                    </form>
                    <input type="text" name="citacion" form="case-form-@item.Id" class="input-inline" size="15"
                           value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.CitationDate)" placeholder="dd/mes/aaaa" />
                </td>
                <td class="name-cell">
                    @if (item.NeedsReview)
                    {
                        <span class="review-alert" title="Requiere revisión — datos incompletos en la fila original">⚠</span>
                    }
                    @if (item.MoralIdoneity == MoralIdoneity.Alertada)
                    {
                        <span class="idoneidad-icon" title="Idoneidad moral: ALERTADA">🚨</span>
                    }
                    else if (item.MoralIdoneity == MoralIdoneity.Revisar)
                    {
                        <span class="idoneidad-icon" title="Idoneidad moral: REVISAR">⚠️</span>
                    }
                    <input type="text" name="nombre" form="case-form-@item.Id" class="input-inline name-input"
                           size="@nameSize" value="@item.FullName" placeholder="Nombre completo" />
                </td>
                <td class="text-cell rut-cell">
                    <span class="rut-con-obs">
                        <input type="text" name="rut" form="case-form-@item.Id" class="input-inline rut-input" size="14" value="@item.Rut" />
                        @* Nota libre por persona, oculta hasta que hace falta: un ícono aparte del RUT
                           en vez de una columna fija que quedaría vacía en casi todas las filas. Mismo
                           panel flotante que LICENCIAS — sin position:fixed calculado por JS, los
                           bordes de las filas de abajo se pintan encima pese al z-index. *@
                        <details class="popover-celda observaciones-celda">
                            <summary title="Observaciones">@(string.IsNullOrWhiteSpace(item.Observations) ? "📝" : "🗒️")</summary>
                            <div class="popover-panel observaciones-panel">
                                <div class="observaciones-panel-header">
                                    <span>Observación — @item.FullName</span>
                                    <button type="button" class="observaciones-cerrar" aria-label="Cerrar" title="Cerrar">×</button>
                                </div>
                                <textarea name="observaciones" form="case-form-@item.Id" readonly
                                          placeholder="Observación sobre esta persona…">@item.Observations</textarea>
                                <div class="observaciones-panel-acciones">
                                    <button type="button" class="observaciones-editar">Editar</button>
                                    <button type="submit" form="case-form-@item.Id" class="btn-primary observaciones-guardar" style="display:none;">Guardar</button>
                                </div>
                            </div>
                        </details>
                    </span>
                </td>
                <td class="text-cell">@OfficeCatalog.Display(item.Office)</td>
                <td>
                    @* Solo la escribe el sistema al marcar un estado de "ya subida" (fillUploadDateIfMissing) —
                       readonly, no disabled, para que el valor siga viajando al guardar. *@
                    <input type="text" name="subida" form="case-form-@item.Id" class="input-inline" size="15"
                           value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.FolderUploadedDate)"
                           placeholder="—" readonly title="Se completa sola al marcar un estado de subida" />
                </td>
                <td>
                    <input type="text" name="ultimaCarpeta" form="case-form-@item.Id" class="input-inline"
                           size="@lastFolderSize" value="@lastFolderText"
                           title="Fecha de la última carpeta, o la comuna donde está la carpeta" />
                </td>
                <td class="text-cell">@FolderSectorCatalog.Display(item.Sector)</td>
                <td>
                    <input type="text" name="codigoF8" form="case-form-@item.Id" class="input-inline"
                           size="@Math.Max(12, (item.CodigoF8?.Length ?? 0) + 2)" value="@item.CodigoF8"
                           placeholder="—" />
                </td>
                <td>
                    <input type="text" name="penultima" form="case-form-@item.Id" class="input-inline" size="15"
                           value="@LicenciasCarpetas.Dashboard.Pages.IndexModel.FormatDate(item.PenultimateFolderDate)"
                           placeholder="dd/mes/aaaa" />
                </td>
                <td>
                    @* Selección múltiple sin lista desplegable con Ctrl: un resumen que se abre y
                       muestra casillas. En una tabla de 15 columnas, diez casillas sueltas por fila
                       no caben, y un <select multiple> obliga a Ctrl+clic para elegir dos clases. *@
                    @{ var licencias = LicenceClassCatalog.Parse(item.LicenceClasses); }
                    <details class="popover-celda licencias-celda">
                        <summary>@LicenceClassCatalog.DisplayList(item.LicenceClasses)</summary>
                        <div class="popover-panel licencias-opciones">
                            @foreach (var licence in LicenceClassCatalog.All)
                            {
                                <label>
                                    <input type="checkbox" name="licencias" form="case-form-@item.Id"
                                           value="@licence" checked="@licencias.Contains(licence)" />
                                    @LicenceClassCatalog.Display(licence)
                                </label>
                            }
                        </div>
                    </details>
                </td>
                @* La columna ATENCIÓN se sacó de la tabla por pedido del operador, pero el valor
                   viaja igual en el formulario: sin él, guardar una fila borraría la atención y la
                   persona dejaría de contar como atendida en Estadísticas. *@
                <input type="hidden" name="atencion" form="case-form-@item.Id" value="@item.AttentionNote" />
                <td>
                    <select name="estado" form="case-form-@item.Id" class="input-inline estado-select"
                            onchange="repaintRow(this)">
                        <option value="">@(item.FolderStateRaw ?? "—")</option>
                        @foreach (var state in FolderStateCatalog.Selectable)
                        {
                            <option value="@state" selected="@(item.FolderState == state)">@FolderStateCatalog.Display(state)</option>
                        }
                        @* Un caso que ya tiene un estado retirado conserva su opción: sin ella el
                           desplegable mostraría "—" y guardar la fila le borraría el estado. *@
                        @if (item.FolderState is { } current && FolderStateCatalog.IsRetired(current))
                        {
                            <option value="@current" selected="selected">@FolderStateCatalog.Display(current)</option>
                        }
                    </select>
                </td>
                <td>
                    <select name="idoneidad" form="case-form-@item.Id" class="input-inline" onchange="repaintIdoneidad(this)">
                        <option value="">—</option>
                        @foreach (var idoneity in MoralIdoneityCatalog.All)
                        {
                            <option value="@idoneity" selected="@(item.MoralIdoneity == idoneity)">@MoralIdoneityCatalog.Display(idoneity)</option>
                        }
                    </select>
                </td>
                <td>
                    <select name="decision" form="case-form-@item.Id" class="input-inline">
                        <option value="">@(item.FinalDecisionRaw ?? "—")</option>
                        @foreach (var decision in FinalDecisionCatalog.All)
                        {
                            <option value="@decision" selected="@(item.FinalDecision == decision)">@FinalDecisionCatalog.Display(decision)</option>
                        }
                    </select>
                </td>
                <td style="display:flex; gap:6px; align-items:center;">
                    @* Quién tocó el caso por última vez: con varias cuentas en la misma agenda,
                       "lo cambió alguien" no sirve para nada. *@
                    <button type="submit" form="case-form-@item.Id" class="btn-primary text-sm"
                            style="padding:4px 10px;"
                            title="@(item.UpdatedBy is { } autor
                                     ? $"Última edición: {autor} — {item.UpdatedAt.LocalDateTime:dd-MM-yyyy HH:mm}"
                                     : "Sin ediciones desde el dashboard")">Guardar</button>
                    <form method="post" asp-page-handler="Delete"
                          onsubmit="return confirm('El caso se mueve a la Papelera y se puede restaurar desde ahí. ¿Confirmar?');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn-danger" title="Mover a la Papelera" aria-label="Mover a la Papelera">✕</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    // El color de la fila lo pinta el servidor al cargar, según el estado guardado. Al elegir otra
    // opción, el color tiene que cambiar en el acto: esperar a guardar deja la fila mostrando el
    // color del estado anterior, que es exactamente lo que el operador usa para leer la agenda.
    function repaintRow(select) {
        var row = select.closest('tr');
        if (!row) return;

        row.className = row.className
            .split(' ')
            .filter(function (c) { return c && c.indexOf('estado-') !== 0; })
            .join(' ');

        if (select.value) {
            row.classList.add('estado-' + select.value.toLowerCase());
        }

        fillUploadDateIfMissing(row, select.value);
        markUnsaved(select);
    }

    // Mismo criterio que el servidor (OnPostSave): elegir un estado de "ya subida" escribe la fecha
    // de hoy en Subida carpeta, salvo que ya tenga una — nunca pisa una fecha real ya cargada. Se
    // hace también acá para que se vea al tiro, no recién después de guardar y recargar.
    var uploadStates = ['SubidaAConaset', 'SubidaConF8', 'SubidaConOficio',
        'CambioDomicilioSubidoAConaset', 'CambioDomicilioSubidoConCorreo'];
    var spanishMonths = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
        'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];

    function fillUploadDateIfMissing(row, estadoValue) {
        var subidaInput = row.querySelector('input[name="subida"]');
        if (!subidaInput) return;

        if (uploadStates.indexOf(estadoValue) === -1) {
            // Se destildó el estado de subida: la fecha que se puso sola se borra con él. Una fecha
            // real, tipeada a mano, queda — el atributo solo marca la que puso este script.
            if (subidaInput.dataset.autofilled === 'true') {
                subidaInput.value = '';
                delete subidaInput.dataset.autofilled;
                markUnsaved(subidaInput);
            }
            return;
        }

        if (subidaInput.value.trim() !== '') return;

        var today = new Date();
        subidaInput.value = today.getDate() + '/' + spanishMonths[today.getMonth()] + '/' + today.getFullYear();
        subidaInput.dataset.autofilled = 'true';
        markUnsaved(subidaInput);
    }

    // Cambiar el desplegable no guarda nada: sin este aviso, el color nuevo hace creer que sí.
    function markUnsaved(field) {
        var row = field.closest('tr');
        if (row) row.classList.add('fila-sin-guardar');
    }

    // Igual que repaintRow con el estado de la carpeta: sin esto, el parpadeo y el ícono junto al
    // nombre solo aparecían después de guardar y recargar, y el operador no tenía forma de saber que
    // la selección "prendió" hasta ese momento.
    var idoneidadIcons = { Alertada: '🚨', Revisar: '⚠️' };
    var idoneidadTitles = { Alertada: 'Idoneidad moral: ALERTADA', Revisar: 'Idoneidad moral: REVISAR' };

    function repaintIdoneidad(select) {
        var row = select.closest('tr');
        if (!row) return;

        row.classList.remove('row-alertada', 'row-revisar');
        if (select.value) {
            row.classList.add('row-' + select.value.toLowerCase());
        }

        var nameCell = row.querySelector('.name-cell');
        if (nameCell) {
            var existing = nameCell.querySelector('.idoneidad-icon');
            if (existing) existing.remove();

            if (select.value && idoneidadIcons[select.value]) {
                var icon = document.createElement('span');
                icon.className = 'idoneidad-icon';
                icon.title = idoneidadTitles[select.value];
                icon.textContent = idoneidadIcons[select.value];
                nameCell.insertBefore(icon, nameCell.firstChild);
            }
        }

        markUnsaved(select);
    }

    // Alterna la clase que hace parpadear las filas en ALERTADA. Va en <body>, no por fila: así una
    // fila que pasa a ALERTADA después de cargada (repaintIdoneidad) también parpadea sin más código.
    setInterval(function () {
        document.body.classList.toggle('idoneidad-flash');
    }, 500);

    document.querySelectorAll('table.cases-index tbody input, table.cases-index tbody select')
        .forEach(function (field) {
            if (field.type === 'checkbox') return;
            field.addEventListener('input', function () {
                // Si el operador toca la fecha a mano deja de ser "la que puso el script": ya no se
                // borra sola si después destilda el estado de subida.
                if (field.name === 'subida') delete field.dataset.autofilled;
                markUnsaved(field);
            });
        });

    // Marcar una casilla no repinta el <summary> por su cuenta — sin esto, el resumen se queda en
    // lo que trajo el servidor hasta guardar la fila, y el operador no ve lo que acaba de tildar.
    document.querySelectorAll('.licencias-celda input[type="checkbox"]')
        .forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var cell = checkbox.closest('.licencias-celda');
                var summary = cell.querySelector('summary');
                var selected = Array.from(cell.querySelectorAll('input[type="checkbox"]:checked'))
                    .map(function (c) { return c.value; });
                summary.textContent = selected.length > 0 ? selected.join(', ') : '—';
                markUnsaved(checkbox);
            });
        });

    // La nota de observaciones cambia el ícono del resumen al tipear, igual que LICENCIAS cambia su
    // resumen al tildar — sin esto, el ícono se queda en lo que trajo el servidor hasta guardar.
    document.querySelectorAll('.observaciones-celda textarea')
        .forEach(function (textarea) {
            textarea.addEventListener('input', function () {
                var summary = textarea.closest('.observaciones-celda').querySelector('summary');
                summary.textContent = textarea.value.trim().length > 0 ? '🗒️' : '📝';
                markUnsaved(textarea);
            });
        });

    document.querySelectorAll('.observaciones-cerrar')
        .forEach(function (boton) {
            boton.addEventListener('click', function () {
                boton.closest('.observaciones-celda').removeAttribute('open');
            });
        });

    // Editar habilita la nota (estaba en solo lectura) y la deja lista para escribir; Guardar
    // manda el mismo formulario de la fila que usa cualquier otro campo — no hay envío aparte.
    document.querySelectorAll('.observaciones-editar')
        .forEach(function (boton) {
            boton.addEventListener('click', function () {
                var panel = boton.closest('.observaciones-panel');
                var textarea = panel.querySelector('textarea');
                textarea.readOnly = false;
                textarea.focus();
                boton.style.display = 'none';
                panel.querySelector('.observaciones-guardar').style.display = '';
            });
        });

    // <details> se queda abierto hasta el próximo clic en su propio resumen — sin esto, el panel
    // (licencias u observaciones) se queda en pantalla aunque el operador ya haya seguido trabajando
    // en otra celda. Un clic fuera de la celda lo cierra, como cualquier menú desplegable.
    document.addEventListener('click', function (event) {
        document.querySelectorAll('.popover-celda[open]').forEach(function (cell) {
            if (!cell.contains(event.target)) {
                cell.removeAttribute('open');
            }
        });
    });

    // Las filas de una tabla pintan sus propios bordes por encima de cualquier hijo absoluto de una
    // fila anterior — z-index no alcanza para escapar de ese orden. `position: fixed`, calculado a
    // mano desde el resumen, saca el panel de la tabla por completo. Como queda anclado a coordenadas
    // de pantalla y no de fila, se cierra solo si la tabla se desplaza para no dejarlo flotando lejos
    // de la celda que lo abrió. Genérico para LICENCIAS y OBSERVACIONES: mismo problema, mismo panel.
    // Nombre y RUT son columnas sticky con fondo opaco: en la franja donde se superponen con un
    // panel fijo, pintan encima pese al z-index (mismo tipo de problema que las filas de la tabla,
    // pero las sticky lo hacen incluso contra position:fixed). El panel nunca puede empezar más a
    // la izquierda que el borde derecho del RUT — así no hay superposición que perder.
    var rutHeader = document.querySelector('table.cases-index thead th.rut-cell');
    document.querySelectorAll('.popover-celda').forEach(function (cell) {
        cell.addEventListener('toggle', function () {
            var panel = cell.querySelector('.popover-panel');
            if (!cell.open || !panel) return;
            var rect = cell.querySelector('summary').getBoundingClientRect();
            var minLeft = rutHeader ? rutHeader.getBoundingClientRect().right + 6 : 0;
            var esObservacion = panel.classList.contains('observaciones-panel');

            if (esObservacion) {
                // Al lado del RUT, no debajo: "debajo" en una fila cerca del borde inferior de la
                // ventana empuja el panel fuera de lo visible. A la derecha, la fila siempre está
                // a la vista porque es la misma fila que el operador ya está mirando.
                var ancho = 260; // igual al width fijo de .observaciones-panel en dashboard.css
                var cabeADerecha = rect.right + 6 + ancho <= window.innerWidth;
                panel.style.position = 'fixed';
                panel.style.top = rect.top + 'px';
                panel.style.left = cabeADerecha
                    ? (rect.right + 6) + 'px'
                    : Math.max(rect.left - ancho - 6, minLeft) + 'px';
                panel.querySelector('textarea').focus();
            }
            else {
                panel.style.position = 'fixed';
                panel.style.top = (rect.bottom + 4) + 'px';
                panel.style.left = Math.max(rect.left, minLeft) + 'px';
            }
        });
    });

    var tableCard = document.querySelector('.card.table-card');
    if (tableCard) {
        tableCard.addEventListener('scroll', function () {
            document.querySelectorAll('.popover-celda[open]').forEach(function (cell) {
                cell.removeAttribute('open');
            });
        });
    }
</script>
<script>
    // Nombre y RUT quedan fijos al desplazarse en horizontal. El nombre ancla en 0; el RUT tiene
    // que empezar justo donde termina el nombre, y ese ancho cambia en cada página (cada campo se
    // dimensiona según el nombre más largo que le tocó). Por eso se mide del DOM en vez de fijarlo
    // en el CSS: un valor a ojo dejaría un hueco o taparía el final del nombre.
    (function () {
        var table = document.querySelector('table.cases-index');
        if (!table) return;

        function placeRutColumn() {
            var nameHeader = table.querySelector('thead th.name-cell');
            if (!nameHeader) return;
            table.style.setProperty('--sticky-rut-left', nameHeader.getBoundingClientRect().width + 'px');
        }

        placeRutColumn();
        window.addEventListener('resize', placeRutColumn);
        // Las fuentes tardan un instante en aplicarse y cambian el ancho medido.
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(placeRutColumn);
        }
    })();
</script>
<script>
    // Checkbox toggles go through fetch() so ticking several rows quickly cannot cancel each other
    // the way competing full-page navigations do.
    function submitCheckboxToggle(checkbox, fieldName) {
        var form = checkbox.form;
        var id = form.querySelector('input[name="id"]').value;
        var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        var body = '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + encodeURIComponent(id);
        if (checkbox.checked) {
            body += '&' + fieldName + '=true';
        }
        fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        });
    }
</script>
}
