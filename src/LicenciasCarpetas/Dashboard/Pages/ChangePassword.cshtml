@page
@model LicenciasCarpetas.Dashboard.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="card" style="padding:20px 24px; max-width:420px;">
    <h1 style="font-size:1.1rem; margin:0 0 12px;">Cambiar contraseña</h1>

    @if (Model.Message is not null)
    {
        <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
    }

    <form method="post" style="display:flex; flex-direction:column; gap:10px;">
        <div>
            <label class="form-label" asp-for="CurrentPassword">Contraseña actual</label>
            <input type="password" asp-for="CurrentPassword" required style="width:100%;" class="reveal-target" />
        </div>
        <div>
            <label class="form-label" asp-for="NewPassword">Nueva contraseña</label>
            <input type="password" asp-for="NewPassword" required style="width:100%;" class="reveal-target" />
        </div>
        <div>
            <label class="form-label" asp-for="ConfirmPassword">Repetir nueva contraseña</label>
            <input type="password" asp-for="ConfirmPassword" required style="width:100%;" class="reveal-target" />
        </div>
        <label style="display:flex; gap:6px; align-items:center; font-size:0.8rem;">
            <input type="checkbox" id="reveal-passwords" /> Mostrar las contraseñas
        </label>
        <button type="submit" class="btn-primary" style="padding:8px 16px;">Guardar</button>
    </form>
</div>

@section Scripts {
<script>
    // One switch for the three fields: the usual mistake here is mistyping the repeat, and it is
    // only visible when both can be read at once.
    document.getElementById('reveal-passwords').addEventListener('change', function () {
        var type = this.checked ? 'text' : 'password';
        document.querySelectorAll('.reveal-target').forEach(function (input) { input.type = type; });
    });
</script>
}
