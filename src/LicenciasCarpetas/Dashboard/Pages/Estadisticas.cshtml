@page
@model LicenciasCarpetas.Dashboard.Pages.EstadisticasModel
@{
    ViewData["Title"] = "Estadísticas";
    var stats = Model.Statistics!;
    var offices = Enum.GetValues<Office>();
}

@if (Model.Message is not null)
{
    <p class="message-banner">@Model.Message</p>
}

<div class="card" style="padding:16px 20px; margin-bottom:16px;">
    <form method="get" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
        <div>
            <label class="form-label" for="year">Año</label>
            <select name="year" id="year" onchange="this.form.submit()">
                @foreach (var year in Model.Years.DefaultIfEmpty(Model.Year))
                {
                    <option value="@year" selected="@(Model.Year == year)">@year</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="month">Mes</label>
            <select name="month" id="month" onchange="this.form.submit()">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.Month == month)">@SpanishDate.MonthName(month)</option>
                }
            </select>
        </div>
    </form>
</div>

@* "Atendido" se marca acá, por día, en vez de fila por fila en la tabla grande de Casos — un
   día de agenda es una lista corta y manejable, la tabla de Casos tiene miles de filas. *@
<div class="card" style="padding:16px 20px; margin-bottom:16px;">
    <h2 class="text-xl" style="margin:0 0 10px;">Marcar asistencia</h2>
    <form method="get" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-bottom: @(Model.AttendanceDayCases.Count > 0 ? "14px" : "0")">
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="month" value="@Model.Month" />
        <div>
            <label class="form-label" for="attendanceDate">Día</label>
            <input type="date" id="attendanceDate" name="attendanceDate" value="@Model.AttendanceDate" />
        </div>
        <button type="submit" class="btn-outline">Ver agenda del día</button>
    </form>
    @if (!string.IsNullOrEmpty(Model.AttendanceDate) && Model.AttendanceDayCases.Count == 0)
    {
        <p class="text-md" style="margin:0; color:var(--color-text-muted);">Sin citaciones ese día.</p>
    }
    @if (Model.AttendanceDayCases.Count > 0)
    {
        <form method="post" asp-page-handler="MarkAttendance" asp-route-year="@Model.Year" asp-route-month="@Model.Month">
            <input type="hidden" name="attendanceDate" value="@Model.AttendanceDate" />
            <table class="cases table-wide">
                <thead>
                    <tr>
                        <th>Atendido</th>
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th>Oficina</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dayCase in Model.AttendanceDayCases)
                    {
                        <tr>
                            <td><input type="checkbox" name="attendedIds" value="@dayCase.Id" checked="@dayCase.Attended" /></td>
                            <td class="text-cell">@dayCase.FullName</td>
                            <td class="text-cell">@dayCase.Rut</td>
                            <td class="text-cell">@OfficeCatalog.Display(dayCase.Office)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="btn-primary" style="margin-top:10px;">Guardar asistencia</button>
        </form>
    }
</div>

@* Mismas tarjetas KPI que F8 y Cambio de Domicilio (dashboard.css, .stats-grid/.stat-tile) — antes
   esto era una línea de texto densa, la única de los tres módulos sin este formato. *@
<h2 class="text-xl" style="margin:0 0 10px;">Resumen de @SpanishDate.MonthName(stats.Month) @stats.Year</h2>
<div class="stats-grid">
    <div class="card stat-tile">
        <div class="stat-value">@stats.ScannedTotal</div>
        <div class="stat-label">Escaneadas</div>
    </div>
    <div class="card stat-tile">
        <div class="stat-value">@stats.UploadedTotal</div>
        <div class="stat-label">Subidas</div>
    </div>
    <div class="card stat-tile">
        <div class="stat-value">@stats.ScheduledTotal</div>
        <div class="stat-label">Agendadas</div>
    </div>
    <div class="card stat-tile">
        <div class="stat-value">@stats.AttendedTotal</div>
        <div class="stat-label">Atendidas</div>
    </div>
    <div class="card stat-tile">
        <div class="stat-value">@LicenciasCarpetas.Dashboard.Pages.EstadisticasModel.Percent(stats.AttendanceRate)</div>
        <div class="stat-label">Atención</div>
    </div>
    @foreach (var office in offices)
    {
        <div class="card stat-tile">
            <div class="stat-value">@stats.AttendedFor(office) / @stats.ScheduledFor(office)</div>
            <div class="stat-label">@OfficeCatalog.Display(office)</div>
        </div>
    }
</div>

<div class="card table-card" style="margin-bottom:16px; max-height:70vh;">
    <table class="cases table-wide">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Escaneadas</th>
                <th>Subidas</th>
                @* La oficina va en una segunda línea: como título de una sola línea, "Agendadas
                   Av. Argentina" era lo que estiraba la columna, no los números de abajo. *@
                @foreach (var office in offices)
                {
                    <th>Agendadas<span class="th-sub">@OfficeCatalog.Display(office)</span></th>
                    <th>Atendidas<span class="th-sub">@OfficeCatalog.Display(office)</span></th>
                    <th>%<span class="th-sub">@OfficeCatalog.Display(office)</span></th>
                }
                <th>Guardar</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var day in stats.Days)
        {
            var formId = $"counters-{day.Date:yyyyMMdd}";
            <tr>
                <td class="text-cell">@day.Date.ToString("dd-MM-yyyy")</td>
                <td>
                    <form method="post" asp-page-handler="SetCounters" id="@formId"
                          asp-route-year="@Model.Year" asp-route-month="@Model.Month">
                        <input type="hidden" name="fecha" value="@day.Date.ToString("yyyy-MM-dd")" />
                    </form>
                    <input type="number" name="escaneadas" form="@formId" class="input-inline input-count" value="@day.Scanned" />
                </td>
                <td>
                    <input type="number" name="subidas" form="@formId" class="input-inline input-count" value="@day.Uploaded" />
                </td>
                @foreach (var office in offices)
                {
                    var entry = day.ByOffice.TryGetValue(office, out var value) ? value : (Scheduled: 0, Attended: 0);
                    <td class="text-cell">@entry.Scheduled</td>
                    <td class="text-cell">@entry.Attended</td>
                    <td class="text-cell">@LicenciasCarpetas.Dashboard.Pages.EstadisticasModel.Percent(day.AttendanceRate(office))</td>
                }
                <td>
                    <button type="submit" form="@formId" class="btn-primary text-sm" style="padding:4px 10px;">Guardar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@* ── Gráficos ────────────────────────────────────────────────────────────────────────────────
   Barras en CSS puro: la comparación entre oficinas o entre estados se ve de un vistazo, y no
   hace falta traer ninguna librería de gráficos a un equipo municipal sin internet garantizado. *@
<div class="card" style="padding:16px 20px; margin-bottom:16px;">
    <h2 class="text-xl" style="margin:0 0 12px;">Atención por oficina</h2>
    @foreach (var office in offices)
    {
        var agendadas = stats.ScheduledFor(office);
        var atendidas = stats.AttendedFor(office);
        var porcentaje = agendadas > 0 ? (double)atendidas / agendadas : 0;
        <div class="grafico-fila">
            <span class="grafico-etiqueta">@OfficeCatalog.Display(office)</span>
            <span class="grafico-barra">
                <span class="grafico-relleno" style="width:@((porcentaje * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
            </span>
            <span class="grafico-valor">@atendidas / @agendadas (@LicenciasCarpetas.Dashboard.Pages.EstadisticasModel.Percent(agendadas > 0 ? porcentaje : null))</span>
        </div>
    }
</div>

@if (stats.LicenceClasses.Count > 0)
{
    var maximo = stats.LicenceClasses.Max(entry => entry.Count);
    <div class="card" style="padding:16px 20px; margin-bottom:16px;">
        <h2 class="text-xl" style="margin:0 0 4px;">Licencias por clase</h2>
        <p class="text-md" style="margin:0 0 12px;">
            @stats.LicencesTotal licencia(s) en total, @stats.ProfessionalLicences profesional(es).
            Una citación que cubre dos clases cuenta en las dos.
        </p>
        @foreach (var (licence, count) in stats.LicenceClasses)
        {
            <div class="grafico-fila">
                <span class="grafico-etiqueta">@LicenceClassCatalog.Display(licence)</span>
                <span class="grafico-barra">
                    <span class="grafico-relleno @(LicenceClassCatalog.IsProfessional(licence) ? "grafico-relleno-profesional" : "")"
                          style="width:@((count * 100.0 / maximo).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></span>
                </span>
                <span class="grafico-valor">@count</span>
            </div>
        }
    </div>
}

@if (stats.FolderStates.Count > 0)
{
    var maximoEstado = stats.FolderStates.Max(entry => entry.Count);
    <div class="card" style="padding:16px 20px; margin-bottom:16px;">
        <h2 class="text-xl" style="margin:0 0 12px;">Estados de carpeta</h2>
        @foreach (var (state, count) in stats.FolderStates)
        {
            <div class="grafico-fila">
                <span class="grafico-etiqueta">@(state is { } value ? FolderStateCatalog.Display(value) : "Sin estado")</span>
                <span class="grafico-barra">
                    @* Cada barra lleva el color con que esa fila se pinta en Casos. *@
                    <span class="grafico-relleno"
                          style="width:@((count * 100.0 / maximoEstado).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%; background:@(state is { } s && FolderStateCatalog.Color(s) is { } color ? color : "#6b7280");"></span>
                </span>
                <span class="grafico-valor">@count</span>
            </div>
        }
    </div>
}

<div style="display:flex; gap:16px; flex-wrap:wrap;">
    <div class="card table-card" style="flex:1; min-width:320px;">
        <table class="cases table-wide">
            <thead><tr><th>Estado de la carpeta</th><th>Casos</th></tr></thead>
            <tbody>
            @foreach (var (state, count) in stats.FolderStates)
            {
                <tr>
                    <td class="text-cell">@(state is { } value ? FolderStateCatalog.Display(value) : "Sin estado")</td>
                    <td class="text-cell">@count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="card table-card" style="flex:1; min-width:320px;">
        <table class="cases table-wide">
            <thead><tr><th>Decisión final</th><th>Casos</th></tr></thead>
            <tbody>
            @foreach (var (decision, count) in stats.FinalDecisions)
            {
                <tr>
                    <td class="text-cell">@(decision is { } value ? FinalDecisionCatalog.Display(value) : "Sin decisión")</td>
                    <td class="text-cell">@count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
